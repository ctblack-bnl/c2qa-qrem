# API keys and secrets
.env

# Data files — PDFs and processed ledger are excluded (large / not meaningful to share).
# records.jsonl IS tracked — it is the corpus source of truth (per the paper) and is
# currently small enough to check into git directly.
data/papers/
data/ingested/processed_ledger.json

# Python
__pycache__/
*.pyc
*.pyo
.DS_Store

# SQLite — ignore all except the materials database
*.sqlite
*.db
!data/ingested/records.db
*.pdf

# Archived doc versions — not part of active project docs
docs/archive/

# Isolated test-ingestion output — keep test runs out of version control
data/ingested/*_test.json
data/ingested/*_test.jsonl